# Godot 4+ specific ignores
Src/.godot/
Src/.nomedia
Src//android/

# Godot-specific ignores
Src/.import/
Src/export.cfg
Src/export_credentials.cfg

# Imported translations (automatically generated from CSV files)
Src/*.translation

# Mono-specific ignores
Src/.mono/
Src/data_*/
Src/mono_crash.*.json

# Covers JetBrains IDEs: IntelliJ, GoLand, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff
Src/Src/.idea/**/workspace.xml
Src/Src/.idea/**/tasks.xml
Src/Src/.idea/**/usage.statistics.xml
Src/Src/.idea/**/dictionaries
Src/Src/.idea/**/shelf

# AWS User-specific
Src/Src/.idea/**/aws.xml

# Generated files
Src/Src/.idea/**/contentModel.xml

# Sensitive or high-churn files
Src/Src/.idea/**/dataSources/
Src/Src/.idea/**/dataSources.ids
Src/Src/.idea/**/dataSources.local.xml
Src/Src/.idea/**/sqlDataSources.xml
Src/Src/.idea/**/dynamic.xml
Src/Src/.idea/**/uiDesigner.xml
Src/Src/.idea/**/dbnavigator.xml

# Gradle
Src/Src/.idea/**/gradle.xml
Src/Src/.idea/**/libraries

# Gradle and Maven with auto-import
# When using Gradle or Maven with auto-import, you should exclude module files,
# since they will be recreated, and may cause churn.  Uncomment if using
# auto-import.
# Src/.idea/artifacts
# Src/.idea/compiler.xml
# Src/.idea/jarRepositories.xml
# Src/.idea/modules.xml
# Src/.idea/*.iml
# Src/.idea/modules
# *.iml
# *.ipr

# CMake
cmake-build-*/

# Mongo Explorer plugin
Src/Src/.idea/**/mongoSettings.xml

# File-based project format
*.iws

# IntelliJ
out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Cursive Clojure plugin
Src/.idea/replstate.xml

# SonarLint plugin
Src/.idea/sonarlint/
Src/.idea/sonarlint.xml # see https://community.sonarsource.com/t/is-the-file-idea-idea-idea-sonarlint-xml-intended-to-be-under-source-control/121119

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Editor-based HTTP Client
Src/.idea/httpRequests
http-client.private.env.json

# Android studio 3.1+ serialized cache file
Src/.idea/caches/build_file_checksums.ser

# Apifox Helper cache
Src/.idea/.cache/.Apifox_Helper
Src/.idea/ApifoxUploaderProjectSetting.xml

# Github Copilot persisted session migrations, see: https://github.com/microsoft/copilot-intellij-feedback/issues/712#issuecomment-3322062215
Src/.idea/**/copilot.data.migration.*.xml